{
  "name": "found",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'vite dev'",
    "typecheck": "tsc6 --noEmit",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "effect:diagnostics": "effect-language-service diagnostics --project tsconfig.json --format pretty --strict --severity error,warning",
    "lint": "pnpm lint:code && pnpm lint:complexity",
    "lint:code": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --fix .",
    "lint:complexity": "eslint . --no-warn-ignored",
    "lint:complexity:reject": "LINT_COMPLEXITY_REJECT_ONLY=1 eslint . --quiet --no-warn-ignored",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:setup": "playwright test --config playwright.verification.config.ts",
    "deadcode": "knip",
    "check": "pnpm typecheck && pnpm effect:diagnostics && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@agentmail/convex": "^0.1.0",
    "@ai-sdk/mcp": "^2.0.40",
    "@ai-sdk/openai": "^4.0.50",
    "@convex-dev/agent": "^0.7.1",
    "@convex-dev/auth": "2.0.0-alpha.1",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/react-query": "^0.1.0",
    "@convex-dev/static-hosting": "^0.2.1",
    "@convex-dev/workflow": "^0.4.6",
    "@convex-dev/workpool": "^0.4.10",
    "@firecrawl/firecrawl-convex": "^0.1.1",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/roboto-mono": "5.3.0",
    "@googlemaps/a2ui": "^0.1.8",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.19",
    "@tanstack/react-start": "^1.168.36",
    "ai": "^7.0.79",
    "border-beam": "1.3.0",
    "convex": "^1.44.0",
    "effect": "4.0.0-rc.112",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "^2.6.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^4.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@effect/language-service": "0.87.2",
    "@oxlint/plugins": "1.80.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/google.maps": "^3.66.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/parser": "8.68.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "convex-test": "^0.0.56",
    "eslint": "10.9.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "knip": "^6.32.2",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ],
    "patchedDependencies": {
      "@agentmail/convex@0.1.0": "patches/@agentmail__convex@0.1.0.patch"
    }
  },
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.18.0"
  }
}
